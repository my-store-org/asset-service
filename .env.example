PORT=3003
# Swagger UI is on at /docs outside production.
# Set SWAGGER=true to force it on in production.
SWAGGER=false
# Who may call this service (comma-separated).
# Includes :3003 so Swagger UI can call the service it is served from,
# and both hostnames because a browser treats them as different origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002,http://localhost:3003,http://127.0.0.1:3003

# --- its own database ---
# The schema builds itself: on boot the service creates the database if it is
# missing, then runs any pending migrations. A new deployment needs nothing
# here but working credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=my_store_assets

# Leave false. Migrations own the schema; synchronize would let TypeORM
# reshape tables on boot, and it is refused outright when NODE_ENV=production.
DB_SYNCHRONIZE=false

# Optional. Set false when the database user is scoped to one schema and has
# no CREATE privilege — create the database by hand once instead.
# DB_AUTO_CREATE=true

# Optional. Set false to skip migrating on boot and run `npm run migration:run`
# as its own deploy step. Prefer that when several instances start at once,
# so they cannot race on the same migration.
# MIGRATIONS_RUN=true

# --- s3 ---
AWS_REGION=ap-southeast-1
S3_BUCKET=my-store-dev-bucket
# CloudFront distribution in front of the bucket.
S3_PUBLIC_HOST=dait7q0tunfcy.cloudfront.net
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
