# Configuration for docker-compose.yml. Copy to .env on the VPS and fill in.
#
#   cp .env.docker.example .env
#
# Read when the container starts, so a change is "docker compose up -d", not a
# rebuild. Compose refuses to start if any of the required ones are missing.

# --- database ---------------------------------------------------------------
# Only ever used inside the compose network; the port is never published.
# Generated fresh — keep these or replace them, but avoid $, # and quotes:
# Compose substitutes these values and those characters do not survive it.
MARIADB_ROOT_PASSWORD=e76f14e82553a0cfce2201174dba8a8b
DB_USER=assets
DB_PASSWORD=a93699b03569eef8c270fab00ee74b93
DB_NAME=my_store_assets

# --- who may call this ------------------------------------------------------
# Only the admin console uploads. The storefront reads images from the CDN and
# never touches this service, so store subdomains do not belong here. Exact
# origins, comma separated, no wildcards.
CORS_ORIGINS=https://admin.my-store.shop

# --- s3 ---------------------------------------------------------------------
# The service refuses to start without a region, and uploads fail without a
# bucket and credentials.
AWS_REGION=ap-southeast-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The CDN host in front of the bucket. This is written onto every asset row,
# so changing it later orphans the images already stored rather than moving
# them.
S3_PUBLIC_HOST=dait7q0tunfcy.cloudfront.net

# Swagger is a development aid. Off on anything reachable from the internet.
SWAGGER=false

# --- one-time: claim images stored before assets had an owner ---
# The scope migration leaves older rows unowned, because the service cannot
# know who uploaded them. If this bucket has only ever served your own shops,
# set the owner here and rebuild; only unowned rows are ever touched, so it is
# safe to leave set afterwards.
# ASSET_BACKFILL_SCOPE=store:your-slug

# --- organizations (client key + secret) ---
# Lets you make each app its own key and secret: POST /clients with header
# x-admin-key. Empty: /clients is turned off. Use a long random value.
ADMIN_KEY=
# true: refuse callers without a client key. Leave false while any app still
# calls without one (my-store browsers do); those callers can not see any
# organization's files either way.
REQUIRE_CLIENT_KEY=false

# Encrypts each organization's secret so the asset console can show it again
# (AES-256-GCM). Empty: ADMIN_KEY is used. Changing it makes stored secrets
# unreadable (they still work; make a new secret to see it again).
SECRETS_KEY=
