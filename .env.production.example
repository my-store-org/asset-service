# Production template for the asset service.
#
# Copy to .env on the server, or paste these into the host's environment
# panel — this service reads process.env, so either works. Unlike the two
# Next apps, nothing here is compiled into a bundle: values are read at
# start-up, so changing one needs a restart, not a rebuild.
#
# This file is a template and is committed. The real one is not: it holds a
# database password and AWS credentials, which is why .env and
# .env.production are both gitignored. Never commit the filled-in copy.

NODE_ENV=production

# Leave PORT unset. The host assigns one and the app reads process.env.PORT;
# hardcoding it makes the app listen somewhere the proxy is not forwarding
# to, which the proxy reports as a bare 503.

# Swagger is a development aid. Off in production unless you need it.
SWAGGER=false

# Who may call this service from a browser. Only the admin console uploads;
# the storefront reads images from the CDN and never touches this service.
# Exact origins, no wildcards — a store subdomain does not need to be here.
CORS_ORIGINS=https://admin.my-store.shop

# --- its own database ---
DB_HOST=194.59.164.32
DB_PORT=3306
DB_USER=u554116939_asset_service
DB_PASSWORD=OkAG1@q;4~:7
DB_NAME=u554116939_asset_service

# Migrations own the schema. synchronize would let TypeORM reshape tables on
# boot — it is refused outright when NODE_ENV=production.
DB_SYNCHRONIZE=false

# Managed hosting gives you a user scoped to one database, with no privilege
# to CREATE another. Create the schema once by hand and leave this false, or
# start-up fails before the port is ever bound.
DB_AUTO_CREATE=false

# --- s3 ---
AWS_REGION=ap-southeast-1
S3_BUCKET=
# CloudFront distribution in front of the bucket. This host is what gets
# stored on every asset row, so changing it later orphans existing images.
S3_PUBLIC_HOST=dait7q0tunfcy.cloudfront.net
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- organizations (client key + secret) ---
# Lets you make each app its own key and secret: POST /clients with header
# x-admin-key. Empty: /clients is turned off. Use a long random value.
ADMIN_KEY=
# true: refuse callers without a client key. Leave false while any app still
# calls without one (my-store browsers do); those callers can not see any
# organization's files either way.
REQUIRE_CLIENT_KEY=false
